    "longrun": { "durationSec": 300, "automation": { "enabled": false, "battleSeconds": 60, "taps": [] } },
    "memoryRecovery": { "durationSec": 60, "recoveryNodesSec": [0, 5], "nonInteractiveExitDelaySec": 1 },
    "batterySaver": { "beforeSec": 5, "afterSec": 5 },
    "storage5GB": { "targetFreeGb": 5, "minimumSafeFreeGb": 3.5 },
    "firstLoad": { "durationSec": 15, "firstMarkerSec": 3, "secondMarkerSec": 8 },
    "manualMarker": { "durationSec": 15, "offsetsSec": [3, 8] },
    "backgroundPressure": { "durationSec": 10, "packages": [], "settleSec": 1, "maxMemAvailableMiB": 1200 },
    "coldStartFirstBattle": { "nonInteractiveHomeDelaySec": 1, "nonInteractiveBattleDelaySec": 1 }
  }
}
