{
  "schemaVersion": 1,
  "profileName": "Launcher cancellation test",
  "packageName": "com.example.game",
  "activity": "auto",
  "targetFps": 30,
  "deviceLabel": "MOCK-CANCEL",
  "deviceSerial": "MOCK123",
  "adbPath": "tests\\mock-adb.ps1",
  "defaults": {
    "durationSec": 60,
    "sampleIntervalSec": 1,
    "maxCollectorSec": 120
  },
  "cases": {
